<script>
  const setupChatAnimation = () => {
    const inputText = document.getElementById('anim-input-text');
    const sendBtn = document.getElementById('anim-send-btn');
    const typingIndicator = document.getElementById('anim-typing-indicator');
    const chatStatus = document.getElementById('chat-status');
    const chatBody = document.getElementById('chat-body');
    const msg1 = document.getElementById('msg-1');
    const msg2 = document.getElementById('msg-2');
    const msg3 = document.getElementById('msg-3');
    const msg4 = document.getElementById('msg-4');

    if (!inputText || !sendBtn || !msg1 || !msg2 || !msg3 || !msg4 || !chatBody) return;

    let isHovered = false;
    const mockup = document.querySelector('.chat-mockup');
    mockup?.addEventListener('mouseenter', () => { isHovered = true; });
    mockup?.addEventListener('mouseleave', () => { isHovered = false; });

    const sleep = (ms: number) => new Promise(resolve => {
      const start = Date.now();
      const interval = setInterval(() => {
        if (!isHovered) {
          if (Date.now() - start >= ms) {
            clearInterval(interval);
            resolve(true);
          }
        }
      }, 40);
    });

    const scrollToBottom = () => {
      if (chatBody) {
        chatBody.scrollTo({
          top: chatBody.scrollHeight,
          behavior: 'smooth'
        });
      }
    };

    const typeString = async (text: string) => {
      for (let i = 0; i <= text.length; i++) {
        if (inputText) inputText.textContent = text.slice(0, i);
        await sleep(50 + Math.random() * 30);
      }
    };

    const runLoop = async () => {
      while (true) {
        // Initial / Reset state
        if (inputText) inputText.textContent = '';
        if (chatStatus) {
          chatStatus.textContent = 'online • asisten finansial';
          chatStatus.style.color = '#16A34A';
        }
        msg1.classList.remove('is-shown');
        msg2.classList.remove('is-shown');
        msg3.classList.remove('is-shown');
        msg4.classList.remove('is-shown');
        if (typingIndicator) typingIndicator.style.display = 'none';
        if (chatBody) chatBody.scrollTop = 0;

        await sleep(700);

        // 1. User types message 1
        await typeString('makan bakso 25rb');
        await sleep(350);

        // Submit action
        sendBtn.classList.add('btn-active');
        await sleep(140);
        sendBtn.classList.remove('btn-active');
        if (inputText) inputText.textContent = '';

        // User message 1 pops up
        msg1.classList.add('is-shown');
        scrollToBottom();
        await sleep(400);

        // Nemo AI starts thinking / typing
        if (chatStatus) {
          chatStatus.textContent = 'Nemo AI sedang mengetik...';
          chatStatus.style.color = '#3B82F6';
        }
        if (typingIndicator) {
          typingIndicator.style.display = 'flex';
          scrollToBottom();
        }
        await sleep(1200);

        // AI reply 1 appears
        if (typingIndicator) typingIndicator.style.display = 'none';
        if (chatStatus) {
          chatStatus.textContent = 'online • asisten finansial';
          chatStatus.style.color = '#16A34A';
        }
        msg2.classList.add('is-shown');
        scrollToBottom();
        await sleep(1800);

        // 2. User types message 2
        await typeString('gaji bulanan masuk 8jt');
        await sleep(350);

        // Submit action
        sendBtn.classList.add('btn-active');
        await sleep(140);
        sendBtn.classList.remove('btn-active');
        if (inputText) inputText.textContent = '';

        // User message 2 pops up
        msg3.classList.add('is-shown');
        scrollToBottom();
        await sleep(400);

        // Nemo AI starts typing
        if (chatStatus) {
          chatStatus.textContent = 'Nemo AI sedang mengetik...';
          chatStatus.style.color = '#3B82F6';
        }
        if (typingIndicator) {
          typingIndicator.style.display = 'flex';
          scrollToBottom();
        }
        await sleep(1200);

        // AI reply 2 appears
        if (typingIndicator) typingIndicator.style.display = 'none';
        if (chatStatus) {
          chatStatus.textContent = 'online • asisten finansial';
          chatStatus.style.color = '#16A34A';
        }
        msg4.classList.add('is-shown');
        scrollToBottom();

        // 3. Pause for reading (5.5s)
        await sleep(5500);
      }
    };

    runLoop();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupChatAnimation);
  } else {
    setupChatAnimation();
  }
</script>
