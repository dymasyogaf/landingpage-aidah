---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Konfirmasi Pembayaran — Aidah"
  description="Upload bukti traktiran kopi kamu untuk mendapatkan akses penuh ke Aidah."
>
  <section class="konfirmasi-section">
    <div class="section-container">
      <div class="section-header">
        <span class="section-badge">Konfirmasi</span>
        <h1 class="section-title">Kirim Bukti Traktiran</h1>
        <p class="section-desc">Upload screenshot bukti transfer kamu ke sini, biar Aidah cek ya!</p>
      </div>

      <div class="chat-interface">
        <div class="chat-header">
          <div class="chat-dots"><span></span><span></span><span></span></div>
          <span class="chat-title">Aidah AI</span>
        </div>
        
        <div class="chat-window" id="chat-window">
          <!-- Initial Aidah Message -->
          <div class="chat-msg chat-ai">
            <div class="ai-avatar-sm">🐠</div>
            <div class="msg-bubble msg-ai-bubble">
              Hai! Boleh kirimkan bukti transfer/traktiran kamu ke sini? 
            </div>
          </div>
          <!-- User upload area will be injected here, and then AI response -->
        </div>

        <div class="chat-input-area" id="upload-area">
          <label for="proof-upload" class="upload-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
            <span>Upload Bukti Transfer</span>
          </label>
          <input type="file" id="proof-upload" accept="image/*" style="display: none;" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import Tesseract from 'tesseract.js';

  // API Key Groq dari environment variable
  const GROQ_API_KEY = (import.meta as any).env?.PUBLIC_GROQ_API_KEY || '';
  const API_ENDPOINT = 'https://api.groq.com/openai/v1/chat/completions';

  const uploadInput = document.getElementById('proof-upload') as HTMLInputElement;
  const chatWindow = document.getElementById('chat-window');
  const uploadArea = document.getElementById('upload-area');

  uploadInput?.addEventListener('change', async function(e) {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    // Sembunyikan area upload
    if (uploadArea) uploadArea.style.display = 'none';

    // 1. Tampilkan pesan user beserta gambar
    const imageUrl = URL.createObjectURL(file);
    const userMsg = document.createElement('div');
    userMsg.className = 'chat-msg chat-user';
    userMsg.innerHTML = `
      <div class="msg-bubble msg-user-bubble" style="padding: 6px;">
        <img src="${imageUrl}" alt="Bukti Transfer" class="chat-uploaded-img" />
      </div>
    `;
    chatWindow?.appendChild(userMsg);
    chatWindow!.scrollTop = chatWindow!.scrollHeight;

    // 2. Tampilkan indikator mengetik
    const typingMsg = document.createElement('div');
    typingMsg.className = 'chat-msg chat-ai typing-msg';
    typingMsg.innerHTML = `
      <div class="ai-avatar-sm">🐠</div>
      <div class="msg-bubble msg-ai-bubble">
        <div class="typing-indicator" style="display:flex; align-items:center; gap:8px;">
          <div style="display:flex; gap:6px;"><span></span><span></span><span></span></div>
          <small style="color:var(--muted); font-size:11px; margin-left:4px;">Memproses struk...</small>
        </div>
      </div>
    `;
    chatWindow?.appendChild(typingMsg);
    chatWindow!.scrollTop = chatWindow!.scrollHeight;

    try {
      // 3. Ekstrak Teks dari Gambar menggunakan Tesseract OCR
      const { data: { text: ocrText } } = await Tesseract.recognize(
        imageUrl,
        'ind+eng', // Deteksi bahasa indonesia & inggris
        { logger: m => console.log(m) }
      );

      console.log("Hasil OCR:", ocrText);

      // 4. Kirim hasil teks OCR ke Groq (menggunakan Llama 3.1 8B Instant untuk Teks)
      const response = await fetch(API_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${GROQ_API_KEY}`
        },
        body: JSON.stringify({
          model: "llama-3.1-8b-instant",
          messages: [
            {
              role: "user",
              content: `Berikut adalah teks hasil scan OCR dari sebuah struk transfer/pembayaran:

"""
${ocrText}
"""

Tugasmu:
1. Pastikan ada nama penerima 'Dymas Yoga Febratama' (atau ejaan yang mirip seperti DYMAS YOGA, dymas, dll).
2. Temukan nominal transaksi (misal: 10.000 atau Rp 50.000).

Jika KEDUANYA sesuai (nama benar dan ada nominal), jawab HANYA dengan nominalnya dalam format Rupiah, contoh: Rp 50.000 (tanpa tambahan kata apapun). 
Jika nama penerima BUKAN Dymas Yoga Febratama, atau tidak ada indikasi nominal sama sekali, jawab dengan persis: Tidak Terdeteksi`
            }
          ],
          temperature: 0,
          max_tokens: 20
        })
      });

      if (!response.ok) {
        throw new Error('API request failed: ' + response.statusText);
      }
      
      const data = await response.json();
      
      // Hapus indikator mengetik
      typingMsg.remove();

      const aiResponseText = data.choices[0].message.content.trim();
      console.log("AI Response:", aiResponseText);
      
      if (aiResponseText.toLowerCase().includes("tidak terdeteksi")) {
         throw new Error("Gambar tidak terdeteksi sebagai bukti pembayaran");
      }

      const nominalDiterima = aiResponseText;
      
      // Tampilkan pesan sukses dari AI
      const finalMsg = document.createElement('div');
      finalMsg.className = 'chat-msg chat-ai';
      finalMsg.innerHTML = `
        <div class="ai-avatar-sm">🐠</div>
        <div class="msg-bubble msg-ai-bubble">
          Wah, terima kasih banyak traktiran kopinya! ☕ Pembayaran sebesar <strong style="color: var(--income-text); background: var(--income-bg); padding: 2px 6px; border-radius: 4px;">${nominalDiterima}</strong> sudah Aidah terima ya.
          <br/><br/>
          Sekarang, yuk daftarkan akunmu supaya Aidah bisa bantu kelola uangmu dengan aman. Jangan sampai boncos lagi ya! 😉
          <br/><br/>
          <a href="https://app.aidah.web.id/register" class="btn-primary" style="display:inline-flex; width: 100%; justify-content: center; margin-top:8px; font-size:14px; padding:10px 16px; border-radius: 12px;">
            Daftar Akun Sekarang
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left:4px;"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      `;
      chatWindow?.appendChild(finalMsg);
      chatWindow!.scrollTop = chatWindow!.scrollHeight;

    } catch (error) {
      console.error(error);
      // Hapus indikator mengetik
      typingMsg.remove();

      // Tampilkan pesan error jika gagal parsing atau bukan bukti tf
      const errorMsg = document.createElement('div');
      errorMsg.className = 'chat-msg chat-ai';
      errorMsg.innerHTML = `
        <div class="ai-avatar-sm">🐠</div>
        <div class="msg-bubble msg-ai-bubble" style="border-color: #F87171;">
          Maaf, Aidah gagal memverifikasi bukti tersebut. Pastikan gambarnya jelas dan transfer ditujukan ke rekening <strong>Dymas Yoga Febratama</strong> ya! Silakan coba unggah kembali foto struk yang benar.
          <br/><br/>
          <div style="display: flex; gap: 8px; flex-direction: column;">
            <button onclick="document.getElementById('proof-upload').click()" class="btn-primary" style="display:inline-flex; width: 100%; justify-content: center; font-size:14px; padding:10px 16px; border-radius: 12px; border: none; cursor: pointer; font-family: inherit;">
              Unggah Ulang Struk
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left:4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
            </button>
            <a href="https://wa.me/6289661209500?text=Halo%20Admin%20Aidah%2C%20saya%20kesulitan%20mengunggah%20bukti%20traktiran%20kopi%20saya.%20Mohon%20bantuannya%20ya%21" target="_blank" style="display:inline-flex; width: 100%; justify-content: center; font-size:14px; padding:10px 16px; border-radius: 12px; background: #25D366; color: white; text-decoration: none; font-weight: 700; border: 2px solid var(--ink); box-shadow: 2px 2px 0 var(--ink); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='4px 4px 0 var(--ink)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='2px 2px 0 var(--ink)';">
              Lapor Kendala
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left:4px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </a>
          </div>
        </div>
      `;
      chatWindow?.appendChild(errorMsg);
      chatWindow!.scrollTop = chatWindow!.scrollHeight;
    }
  });
</script>

<style is:global>
  .konfirmasi-section {
    padding: 120px 0 100px;
    background: linear-gradient(135deg, var(--blue-50) 0%, #ffffff 100%);
    min-height: 100vh;
  }
  .chat-interface {
    max-width: 480px;
    margin: 0 auto;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 10px 10px 0 var(--ink);
    display: flex;
    flex-direction: column;
    transform: translateY(0);
    transition: var(--transition);
  }
  .chat-interface:hover {
    transform: translateY(-4px);
    box-shadow: 14px 14px 0 var(--ink);
  }
  .chat-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 2px solid var(--ink);
    position: relative;
    z-index: 10;
  }
  .chat-dots {
    display: flex;
    gap: 6px;
  }
  .chat-dots span {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .chat-dots span:first-child { background: #F87171; }
  .chat-dots span:nth-child(2) { background: #FBBF24; }
  .chat-dots span:last-child { background: #4ADE80; }
  
  .chat-title {
    font-size: 15px;
    font-weight: 900;
    color: var(--text);
    margin-left: auto;
    margin-right: auto;
    letter-spacing: 0.5px;
  }
  .chat-window {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 400px;
    max-height: 60vh;
    overflow-y: auto;
    background-color: #f8fafc;
    background-image: radial-gradient(var(--blue-200) 1px, transparent 1px);
    background-size: 20px 20px;
    position: relative;
    overflow-x: hidden;
  }
  .chat-msg {
    display: flex;
    gap: 12px;
    animation: msgIn 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  .chat-user {
    justify-content: flex-end;
  }
  .chat-ai {
    align-items: flex-start;
  }
  @keyframes msgIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .msg-bubble {
    padding: 14px 18px;
    border-radius: 20px;
    font-size: 14.5px;
    line-height: 1.6;
    font-weight: 700;
    max-width: 85%;
    position: relative;
    z-index: 2;
  }
  .msg-user-bubble {
    background: linear-gradient(135deg, var(--blue-500) 0%, var(--blue-600) 100%);
    color: #fff;
    border-bottom-right-radius: 6px;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }
  .msg-ai-bubble {
    background: #fff;
    border: 2px solid var(--ink);
    color: var(--text);
    border-bottom-left-radius: 6px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .ai-avatar-sm {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--blue-400), var(--blue-600));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    margin-top: 2px;
    border: 2px solid var(--ink);
    color: #fff;
    box-shadow: 2px 2px 0 var(--ink);
  }
  
  .chat-uploaded-img {
    max-width: 220px;
    max-height: 280px;
    width: auto;
    height: auto;
    border-radius: 12px;
    display: block;
    object-fit: cover;
    object-position: top;
    border: 2px solid rgba(255,255,255,0.2);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .chat-input-area {
    padding: 24px;
    background: #ffffff;
    border-top: 2px solid var(--ink);
    position: relative;
    z-index: 10;
  }
  .upload-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 16px;
    background: var(--blue-50);
    border: 2px dashed var(--blue-500);
    border-radius: 16px;
    color: var(--blue-700);
    font-weight: 900;
    font-size: 16px;
    cursor: pointer;
    transition: var(--transition);
  }
  .upload-btn:hover {
    background: var(--blue-100);
    border-color: var(--blue-600);
    transform: translateY(-2px);
  }
  .upload-btn:active {
    transform: translateY(0);
  }

  /* Typing Indicator */
  .typing-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
  }
  .typing-indicator span {
    width: 8px;
    height: 8px;
    background: var(--blue-400);
    border-radius: 50%;
    animation: typing 1.4s infinite ease-in-out;
  }
  .typing-indicator span:nth-child(1) { animation-delay: 0s; }
  .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typing {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50% { transform: translateY(-4px); opacity: 1; }
  }
</style>
