<script>
  // ================= 1. INTERACTIVE CHAT SIMULATOR =================
  const promptButtons = document.querySelectorAll('.sim-prompt-btn');
  const userTextEl = document.getElementById('sim-user-text');
  const tagEl = document.getElementById('sim-tag');
  const amtEl = document.getElementById('sim-amt');
  const catEl = document.getElementById('sim-cat');
  const descEl = document.getElementById('sim-desc');
  const aiCardEl = document.getElementById('sim-ai-card');

  promptButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      promptButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const msg = btn.getAttribute('data-msg') || '';
      const type = btn.getAttribute('data-type') || 'expense';
      const amt = btn.getAttribute('data-amt') || '';
      const cat = btn.getAttribute('data-cat') || '';
      const reply = btn.getAttribute('data-reply') || '';

      if (userTextEl) userTextEl.textContent = msg;
      if (amtEl) amtEl.textContent = (type === 'income' ? '+' : '-') + amt.replace('-', '');
      if (catEl) catEl.innerHTML = `Pos: <strong>${cat}</strong>`;
      if (descEl) descEl.textContent = reply;

      if (tagEl) {
        if (type === 'income') {
          tagEl.textContent = '💰 Pemasukan';
          tagEl.className = 'sim-card-tag tag-inc';
        } else if (type === 'recurring') {
          tagEl.textContent = '🔄 Tagihan Rutin Bulanan';
          tagEl.className = 'sim-card-tag tag-rec';
        } else if (type === 'goal') {
          tagEl.textContent = '⭐ Alokasi Tabungan Impian';
          tagEl.className = 'sim-card-tag tag-goal';
        } else {
          tagEl.textContent = '📋 Pengeluaran';
          tagEl.className = 'sim-card-tag';
        }
      }

      // Micro animation
      if (aiCardEl) {
        aiCardEl.style.transform = 'scale(0.97)';
        setTimeout(() => {
          aiCardEl.style.transform = 'scale(1)';
        }, 120);
      }
    });
  });

  // ================= 2. LIVE SEARCH & FILTER =================
  const searchInput = document.getElementById('gb-search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('gb-clear-search');
  const moduleCards = document.querySelectorAll('.gb-module-card');
  const tagPills = document.querySelectorAll('.tag-pill');

  function performSearch(query: string) {
    const q = query.toLowerCase().trim();
    if (clearBtn) clearBtn.style.display = q ? 'block' : 'none';

    moduleCards.forEach((card) => {
      const el = card as HTMLElement;
      const keywords = (el.getAttribute('data-keywords') || '') + ' ' + el.innerText.toLowerCase();
      if (!q || keywords.includes(q)) {
        el.style.display = 'block';
      } else {
        el.style.display = 'none';
      }
    });
  }

  searchInput?.addEventListener('input', (e) => {
    performSearch((e.target as HTMLInputElement).value);
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      performSearch('');
      searchInput.focus();
    }
  });

  tagPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const q = pill.getAttribute('data-query') || '';
      if (searchInput) {
        searchInput.value = q;
        performSearch(q);
        const firstMatch = document.querySelector('.gb-module-card[style*="block"]') || document.querySelector('.gb-module-card:not([style*="none"])');
        if (firstMatch) {
          firstMatch.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });

  // ================= 3. ACTIVE STICKY NAV HIGHLIGHT =================
  const navLinks = document.querySelectorAll('.gb-nav-link');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach((link) => {
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      });
    },
    { threshold: 0.25, rootMargin: '-80px 0px -40% 0px' }
  );

  moduleCards.forEach((card) => observer.observe(card));

  // ================= 4. POPUP BOTTOM BAR SCROLL TRIGGER =================
  const bottomBar = document.getElementById('gb-bottom-bar');
  const closeBottomBarBtn = document.getElementById('btn-close-bottom-bar');
  let isBottomBarDismissed = false;

  closeBottomBarBtn?.addEventListener('click', () => {
    isBottomBarDismissed = true;
    bottomBar?.classList.remove('is-visible');
    bottomBar?.setAttribute('aria-hidden', 'true');
  });

  const checkScrollBottom = () => {
    if (isBottomBarDismissed || !bottomBar) return;

    const scrollY = window.scrollY || window.pageYOffset;
    const windowHeight = window.innerHeight;
    const docHeight = document.documentElement.scrollHeight;

    // Muncul saat user sudah scroll melewati 70% halaman atau sisa jarak ke bawah < 850px
    const scrollPercent = (scrollY + windowHeight) / docHeight;
    const isNearBottom = scrollPercent > 0.70 || (docHeight - (scrollY + windowHeight)) < 850;

    if (isNearBottom) {
      bottomBar.classList.add('is-visible');
      bottomBar.setAttribute('aria-hidden', 'false');
    } else {
      bottomBar.classList.remove('is-visible');
      bottomBar.setAttribute('aria-hidden', 'true');
    }
  };

  window.addEventListener('scroll', checkScrollBottom, { passive: true });
  checkScrollBottom();
</script>

